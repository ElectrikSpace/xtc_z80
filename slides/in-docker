#!/usr/bin/env bash
set -euo pipefail

image="registry.gitlab.inria.fr/corse/dockerfiles/latex-build:1.5.0"

# Not necessary for public images
#local="$(docker image ls -q "$image" 2>/dev/null || true)"
#[ -n "$local" ] || docker login "$repo"

# Set umask before executing commands
# Note that this limits commands to non quoted arguments, would require re-quoting...
umask="$(umask)"
docker_args=(--rm -u "$(id -u):$(id -g)" -v "$PWD:$PWD" -w "$PWD")
if [ -t 0 ]; then
  docker_args+=(-it)
fi
exec docker run "${docker_args[@]}" "$image" bash -c "umask $umask; $*"
